    renderTasks($root, statData);

    const buttonBar = $('<div>').addClass('button-container');
    const drawPoints = Number(e(statData['系統']?.['抽卡點數'])) || 0;
    buttonBar.append(createDrawPointsButton(drawPoints));
    buttonBar.append($('<button>').addClass('inventory-btn').text('查看地圖').on('click', () => openImageViewerModal(statData, displayData)));
    const currentWeight = Number(e(statData['狀態']?.['當前負重'] ?? 0));
    const weightLimit = Number(e(statData['次生屬性']?.['負重上限'] ?? 50));
    buttonBar.append($('<button>').addClass('inventory-btn').text('打開物品欄').on('click', () => i(statData['裝備'], statData['攜帶物品'], currentWeight, weightLimit)));
    $root.append(buttonBar);

  } catch (error) { console.error('Error rendering UI:', error); }
}

$(() => {
