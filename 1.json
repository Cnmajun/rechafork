.image-viewer__canvas {
  position: relative; flex: 1; margin: 0 24px 24px; overflow: hidden; touch-action: none;
  background: radial-gradient(circle at 35% 30%, rgba(94, 161, 255, 0.14), rgba(9, 13, 22, 0.92));
