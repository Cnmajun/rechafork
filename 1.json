// =================== 新的任務渲染函數 (v5.0 最終穩定版) ================
// ====================================================================
function renderTasks(container, data) {
    const system = data['系統'] ?? {};
    const mainTaskData = system['主線任務'];
    const sideTaskData = system['支線任務'];
    const emergencyTaskData = system['緊急任務'];
    const dailyTaskData = system['日常任務'];

    const taskBar = $('<div>').addClass('task-bar');
    $('<div>').addClass('section__title').text('任務').appendTo(taskBar);

    const createTaskCard = (taskData, taskType) => {
        // 如果任務數據不存在，則不創建卡片
        if (!taskData || typeof taskData !== 'object' || Object.keys(taskData).length === 0) {
             // 針對緊急任務，如果不存在，則顯示一個佔位符
            if (taskType === 'emergency') {
                const card = $('<div>').addClass('task-card emergency-task').css('opacity', '0.6');
                const header = $('<div>').addClass('task-header').css('cursor', 'default');
                $('<div>').addClass('task-title').text('緊急任務').appendTo(header);
                $('<div>').addClass('task-status').text('暫無').appendTo(header);
                card.append(header);
                return card;
            }
            return null; // 其他類型的任務不存在時不顯示
        }


        const card = $('<div>').addClass('task-card');
        let titlePrefix = '';
        switch(taskType) {
            case 'main': card.addClass('main-task'); titlePrefix = '主線'; break;
            case 'side': card.addClass('side-task'); titlePrefix = '支線'; break;
            case 'emergency': card.addClass('emergency-task'); titlePrefix = '緊急'; break;
            case 'daily': card.addClass('daily-task'); titlePrefix = '日常'; break;
        }

        const header = $('<div>').addClass('task-header');
        header.css('position', 'relative');

        const fullDesc = textify(taskData['描述'], '');
        const titleMatch = fullDesc.match(/【(.*?)】/);
        const title = titleMatch ? titleMatch[1] : `${titlePrefix}任務`;
        const description = titleMatch ? fullDesc.replace(`【${title}】：`, '').trim() : fullDesc;

        $('<div>').addClass('task-title').text(title).appendTo(header);
        $('<div>').addClass('task-status').text(textify(taskData['狀態'], '進行中')).appendTo(header);

        const indicator = $('<span>').html('▼').css({
            'margin-left': 'auto',
            'transform': 'rotate(-90deg)',
            'transition': 'transform 0.3s ease'
        });
        header.append(indicator);

        const body = $('<div>').addClass('task-body collapsible__body').hide();

        $('<p>').addClass('task-description').html(description.replace(/\n/g, '<br>')).appendTo(body);

        const objectives = $('<div>').addClass('task-objectives');
        $('<div>').addClass('task-section-title').text('目標').appendTo(objectives);
        const targets = taskData['目標'] ?? {};
        const progresses = taskData['進度'] ?? {};
        Object.entries(targets).forEach(([key, targetValue]) => {
            const current = progresses[key] ?? 0;
            const item = $('<div>').addClass('objective-item');
            if (taskType === 'side') item.addClass('side-task-obj');
            if (taskType === 'emergency') item.addClass('emergency-task-obj');
            if (taskType === 'daily') item.addClass('daily-task-obj');
            if (current >= targetValue) item.addClass('completed');
            $('<span>').addClass('objective-text').text(key).appendTo(item);
            $('<span>').addClass('objective-progress').text(`(${current} / ${targetValue})`).appendTo(item);
            objectives.append(item);
        });
        body.append(objectives);

        const rewards = $('<div>').addClass('task-rewards');
        $('<div>').addClass('task-section-title').text('獎勵').appendTo(rewards);
        const rewardList = $('<div>').addClass('reward-list');
        if (taskData['獎勵'] && taskData['獎勵']['抽卡點數']) {
            $('<div>').addClass('reward-item').text(`抽卡點數 +${taskData['獎勵']['抽卡點數']}`).appendTo(rewardList);
        }
        rewards.append(rewardList);
        body.append(rewards);

        if (taskData['獎勵'] && taskData['獎勵']['超額獎勵']) {
            // ... (超額獎勵渲染代碼保持不變)
        }

        card.append(header, body);

        // =================== 超額獎勵修正代碼 ===================
        if (taskData['獎勵'] && taskData['獎勵']['超額獎勵']) {
            const bonus = taskData['獎勵']['超額獎勵'];
            // 檢查 bonus 是否是一個有效的對象
            if (bonus && typeof bonus === 'object') {
                const bonusObjectives = $('<div>').addClass('task-objectives').css('margin-top', '10px');
                $('<div>').addClass('task-section-title').text('超額目標').appendTo(bonusObjectives);

                const bonusDesc = textify(bonus['描述'], '完成超額目標');
                const bonusProgress = bonus['進度'] ?? 0;
                const bonusTarget = bonus['目標'] ?? 1;

                // 根據任務類型為超額目標也加上對應的class
                const bonusObjectiveItem = $('<div>').addClass('objective-item');
                if (taskType === 'side') bonusObjectiveItem.addClass('side-task-obj');
                if (taskType === 'emergency') bonusObjectiveItem.addClass('emergency-task-obj');
                if (taskType === 'daily') bonusObjectiveItem.addClass('daily-task-obj');

                // 如果超額目標的進度大於等於目標值，就給它加上 'completed' 這個 class
                if (bonusProgress >= bonusTarget) {
                    bonusObjectiveItem.addClass('completed');
                }

                // 組合描述和進度
                $('<span>').addClass('objective-text').text(bonusDesc).appendTo(bonusObjectiveItem);
                $('<span>').addClass('objective-progress').text(`(${bonusProgress}/${bonusTarget})`).appendTo(bonusObjectiveItem);

                bonusObjectives.append(bonusObjectiveItem);
                body.append(bonusObjectives);

                const bonusRewards = $('<div>').addClass('task-rewards');
                const bonusRewardList = $('<div>').addClass('reward-list');
                if (bonus['抽卡點數']) {
                    $('<div>').addClass('reward-item').text(`抽卡點數 +${bonus['抽卡點數']}`).appendTo(bonusRewardList);
                }
                // 如果還有其他類型的超額獎勵，也可以在這裡添加
                bonusRewards.append(bonusRewardList);
                body.append(bonusRewards);
                }
                }

        header.on('click', function() {
            if (body.is(':visible')) {
                body.slideUp(200);
                card.removeClass('active');
                indicator.css('transform', 'rotate(-90deg)');
            } else {
                body.slideDown(200);
                card.addClass('active');
                indicator.css('transform', 'rotate(0deg)');
            }
        });

        return card;
    };

    // 按照 緊急 -> 主線 -> 支線 -> 日常 的順序渲染
    const emergencyTaskCard = createTaskCard(emergencyTaskData, 'emergency');
    if (emergencyTaskCard) taskBar.append(emergencyTaskCard);
    else {
        // 確保即使變量不存在，也顯示「暫無緊急任務」的佔位符
        const placeholderCard = $('<div>').addClass('task-card emergency-task').css('opacity', '0.6');
        const placeholderHeader = $('<div>').addClass('task-header').css('cursor', 'default');
        $('<div>').addClass('task-title').text('緊急任務').appendTo(placeholderHeader);
        $('<div>').addClass('task-status').text('暫無').appendTo(placeholderHeader);
        placeholderCard.append(placeholderHeader);
        taskBar.append(placeholderCard);
    }


    const mainTaskCard = createTaskCard(mainTaskData, 'main');
    if (mainTaskCard) taskBar.append(mainTaskCard);

    const sideTaskCard = createTaskCard(sideTaskData, 'side');
    if (sideTaskCard) taskBar.append(sideTaskCard);

    const dailyTaskCard = createTaskCard(dailyTaskData, 'daily');
    if (dailyTaskCard) {
        taskBar.append(dailyTaskCard);
    } else {
        // 如果日常任務數據不存在 (dailyTaskData is null or undefined)
        // 我們就手動創建一個佔位符卡片
        const placeholderCard = $('<div>').addClass('task-card daily-task').css('opacity', '0.6');
        const placeholderHeader = $('<div>').addClass('task-header').css('cursor', 'default');
        $('<div>').addClass('task-title').text('日常任務').appendTo(placeholderHeader);
        $('<div>').addClass('task-status').text('暫無').appendTo(placeholderHeader);
        placeholderCard.append(placeholderHeader);
        taskBar.append(placeholderCard);
}

    container.append(taskBar);
}
