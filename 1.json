        $('<span>').addClass('item__key').text(key).appendTo(li);
        $('<span>').addClass('item__value').text(textify(value, '--')).appendTo(li);
        list.append(li);
    });
    target.append(list);
}

function renderUnifiedStatus(target, statData) {
    const wrapper = $('<div>').addClass('phys-mental-wrapper');
    const leftCol = $('<div>').addClass('phys-col');
    const rightCol = $('<div>').addClass('mental-col');

    const phys = statData['生理'] ?? {};
    const mental = statData['精神'] ?? {};
    const state = statData['狀態'] ?? {};
    const secondary = statData['次生屬性'] ?? {};

    // Left Column: 負重及營養
    $('<div>').addClass('section__title').text('負重及營養').appendTo(leftCol);

    const currentWeight = Number(e(state['當前負重'] ?? 0));
    const maxWeight = Number(e(secondary['負重上限'] ?? 0));
    // --- 負重顯示修改 ---
    leftCol.append(t(`負重: ${currentWeight.toFixed(1)}/${maxWeight.toFixed(1)} kg`, currentWeight, maxWeight, 'weight-progress'));

    leftCol.append(t('飽腹感', Number(e(secondary['飽腹感'] ?? 0)), 100, 'hunger-progress'));
    leftCol.append(t('水分', Number(e(phys['水分'] ?? 0)), 100, 'water-progress'));
    leftCol.append(t('蛋白質', Number(e(phys['蛋白質'] ?? 0)), s['蛋白質'], 'protein-progress'));
    leftCol.append(t('維生素', Number(e(phys['維生素'] ?? 0)), 100, 'vitamin-progress'));
    leftCol.append(t('碳水', Number(e(phys['碳水'] ?? 0)), s['碳水'], 'carbs-progress'));
    leftCol.append(t('脂肪', Number(e(phys['脂肪'] ?? 0)), s['脂肪'], 'fat-progress'));

    const immuneLoad = Number(e(phys['免疫負荷'] ?? 0));
    const immunePower = Number(e(secondary['免疫力'] ?? 0));
    const immuneWrapper = $('<div>').addClass('progress-wrapper');
    $('<div>').text(`免疫負荷: ${immuneLoad} / 免疫力: ${immunePower}`).appendTo(immuneWrapper);
    const immuneBarDiv = $('<div>').addClass('immune-bar');
    $('<div>').addClass('immune-fill').css('width', `${Math.min((immuneLoad / 100) * 100, 100)}%`).appendTo(immuneBarDiv);
    $('<div>').addClass('immune-marker').css('left', `${Math.min((immunePower / 100) * 100, 100)}%`).appendTo(immuneBarDiv);
    immuneWrapper.append(immuneBarDiv);
    leftCol.append(immuneWrapper);

    const nitrogen = Number(e(phys['氮平衡'] ?? 0));
    const nitrogenValue = Math.max(-100, Math.min(100, nitrogen));
    const nitrogenWrapper = $('<div>').addClass('progress-wrapper nitrogen-balance');
    $('<div>').text(`氮平衡: ${nitrogen}`).appendTo(nitrogenWrapper);
    const gradient = $('<div>').addClass('nitrogen-gradient');
    $('<div>').addClass('nitrogen-marker').css('left', `${((nitrogenValue + 100) / 200) * 100}%`).appendTo(gradient);
    nitrogenWrapper.append(gradient);
    leftCol.append(nitrogenWrapper);

    // Right Column: 精神及狀態
    $('<div>').addClass('section__title').text('精神及狀態').appendTo(rightCol);

    rightCol.append(t('壓力', Number(e(mental['壓力'] ?? 0)), 100));
    rightCol.append(t('無聊', Number(e(mental['無聊'] ?? 0)), 100));
    rightCol.append(t('孤獨', Number(e(mental['孤獨'] ?? 0)), 100));
    rightCol.append(t('睡眠', Number(e(mental['睡眠'] ?? 0)), 100));

    // --- 狀態值圖示化 ---
    rightCol.append(t('表皮濕度', Number(e(state['表皮濕度'] ?? 0)), 100));
    rightCol.append(t('清潔', Number(e(state['清潔'] ?? 0)), 100));
    rightCol.append(t('感染', Number(e(state['感染'] ?? 0)), 100, 'danger-progress')); // You can add custom classes for colors
    rightCol.append(t('疼痛', Number(e(state['疼痛'] ?? 0)), 100, 'warning-progress'));

    const kvData = {
        '受傷': textify(state['受傷'], '無'),
        '流血': textify(state['流血'], '無'),
        '疾病': textify(state['疾病'], '無')
    };
    renderKeyValueList(rightCol, kvData);

    wrapper.append(leftCol, rightCol);
    target.append(wrapper);
}


function renderAttributesAndSkills(target, attributesSource, skillsSource, talentsSource, companionDetails = null) {
  const wrapper = $('<div>').addClass('attr-skill-wrapper');
  const leftCol = $('<div>').addClass('attr-col');

  $('<div>').addClass('section__title').text('屬性').appendTo(leftCol);
  Object.entries(firstMeaningfulObject(attributesSource)).forEach(([name, detail]) => {
    if (detail && typeof detail === 'object') {
      const level = Number(e(detail['等級'] ?? 0));
      const exp = Number(e(detail['當前經驗'] ?? 0));
      const required = Number(e(detail['升級所需經驗'] ?? 1)) || 1;
      leftCol.append($('<div>').text(`${name} Lv.${level}`));
      leftCol.append(t('', exp, required));
    }
  });

  const talentEntries = toEntries(talentsSource);
  if (talentEntries.length > 0) {
    leftCol.append($('<div>').addClass('section__title').css('margin-top', '20px').text('天賦'));
    talentEntries.forEach(([name, value]) => {
      const item = $('<div>').addClass('skill-item');
      $('<div>').addClass('skill-name').text(name).appendTo(item);
      const desc = typeof value === 'string' ? value : textify(value?.['描述'] ?? '', '');
      if (desc) $('<div>').addClass('skill-desc').text(desc).appendTo(item);
      leftCol.append(item);
    });
  }
  wrapper.append(leftCol);

  const rightCol = $('<div>').addClass('skill-col');
  $('<div>').addClass('section__title').text('技能').appendTo(rightCol);
  const skillEntries = toEntries(skillsSource);
  if (skillEntries.length === 0) {
    rightCol.append($('<p>').addClass('empty-text').text('暫無技能'));
  } else {
    skillEntries.forEach(([name, value]) => {
      if (value && typeof value === 'object') {
        const level = Number(e(value['等級'] ?? 0));
        const exp = Number(e(value['當前經驗'] ?? 0));
        const required = Number(e(value['升級所需經驗'] ?? 1)) || 1;
        const item = $('<div>').addClass('skill-item');
        $('<div>').addClass('skill-name').text(`${name} Lv.${level}`).appendTo(item);
        item.append(t('', exp, required));
        rightCol.append(item);
      }
    });
  }

  // --- 持有物品 section, only for companions ---
  if (companionDetails) {
      $('<div>').addClass('section__title').css('margin-top', '20px').text('持有物品').appendTo(rightCol);
      const items = firstMeaningfulObject(companionDetails['持有物品']);
      const itemEntries = Object.entries(items);

      if (itemEntries.length === 0) {
          rightCol.append($('<p>').addClass('empty-text').text('無持有物品'));
      } else {
          const itemList = $('<div>').addClass('inventory-list');
          itemEntries.forEach(([itemName, itemDetails]) => {
              const itemCard = $('<div>').addClass('inventory-list-item');
              $('<div>').addClass('item-name').text(itemName).appendTo(itemCard);
              if (itemDetails && typeof itemDetails === 'object') {
                  const props = $('<div>').addClass('item-props');
                  Object.entries(itemDetails).forEach(([key, value]) => {
                      const line = $('<div>').addClass('item-prop');
                      $('<span>').addClass('prop-key').text(String(key)).appendTo(line);
                      $('<span>').addClass('prop-sep').text(': ').appendTo(line);
                      $('<span>').addClass('prop-val').text(textify(value, '')).appendTo(line);
                      props.append(line);
                  });
                  itemCard.append(props);
              }
              itemList.append(itemCard);
          });
          rightCol.append(itemList);
      }
  }

  wrapper.append(rightCol);
  target.append(wrapper);
}

function renderKeyValueTree(target, data) {
    const list = $('<ul>').addClass('section__list');
    toEntries(data).forEach(([key, value]) => {
        const li = $('<li>');
        if (value && typeof value === 'object') {
            li.append($('<div>').addClass('item').append($('<span>').addClass('item__key').text(String(key))));
            renderKeyValueTree(li, value);
        } else {
            li.append($('<div>').addClass('item').append($('<span>').addClass('item__key').text(String(key)), $('<span>').addClass('item__value').text(textify(value, ''))));
        }
        list.append(li);
    });
    target.append(list);
}


function renderCollapsibleSection(container, title, source, expanded = false) {
    if (!source || toEntries(source).length === 0) return;
    const { $section, $body } = d(title, expanded);
    const entries = toEntries(source);
    const isObjectOfObjects = entries.every(([, v]) => v && typeof v === 'object' && !Array.isArray(v));

    if (isObjectOfObjects) {
        entries.forEach(([name, detail]) => {
            const card = $('<div>').addClass('other-card');
            $('<div>').addClass('other-card__title').text(String(name)).appendTo(card);
            renderKeyValueTree(card, detail);
            $body.append(card);
        });
    } else {
        renderKeyValueTree($body, source);
    }
    container.append($section);
}

function renderCompanions(container, companionsSource) {
    if (!companionsSource || toEntries(companionsSource).length === 0) return;
    // 修正: 默認不展開同伴大類別
    const { $section, $body } = d('同伴', false);

    toEntries(companionsSource).forEach(([name, details]) => {
        if (details && typeof details === 'object') {
            // 修正: 每個同伴卡片默認也是摺疊的
            const card = $('<div>').addClass('collapsible').css('margin-bottom', '10px');
            const cardHeader = $('<div>').addClass('collapsible__header').text(name);
            const cardBody = $('<div>').addClass('collapsible__body'); // 默認隱藏

            // 保持其他內容不變...
            const identity = textify(details['身份'], '');
            if (identity) {
                 $('<div>').css({'font-size': '14px', 'font-weight': 'bold', 'color': 'var(--survival-warning)', 'margin-bottom': '15px'}).text(`關係: ${identity}`).appendTo(cardBody);
            }
            const statusContainer = $('<div>').css('margin-bottom', '20px');
            $('<div>').addClass('section__title').text('狀態').appendTo(statusContainer);
            const love = Math.min(Number(e(details['好感度'] ?? 0)), 120);
            const trust = Math.min(Number(e(details['信賴度'] ?? 0)), 120);
            const desire = Math.min(Number(e(details['性慾值'] ?? 0)), 100);
            const dev = Math.min(Number(e(details['開發度'] ?? 0)), 100);
            const health = Math.min(Number(e(details['健康度'] ?? 0)), 100);
            const satiety = Math.min(Number(e(details['飽腹感'] ?? 0)), 100);
            const fatigue = Math.min(Number(e(details['疲勞度'] ?? 0)), 100);
            statusContainer.append(t(`好感度: ${love}/120 (${getFavorabilityStatus(love)})`, love, 120, 'love-progress'));
            statusContainer.append(t(`信賴度: ${trust}/120 (${getTrustStatus(trust)})`, trust, 120, 'trust-progress'));
            statusContainer.append(t(`性慾值: ${desire}/100 (${getDesireStatus(desire)})`, desire, 100, 'desire-progress'));
            statusContainer.append(t(`開發度: ${dev}/100`, dev, 100, 'dev-progress'));
            statusContainer.append(t(`健康度: ${health}/100 (${getHealthStatus(health)})`, health, 100, 'health-progress'));
            statusContainer.append(t(`飽腹感: ${satiety}/100`, satiety, 100, 'satiety-progress'));
            statusContainer.append(t(`疲勞度: ${fatigue}/100`, fatigue, 100, 'fatigue-progress'));
            cardBody.append(statusContainer);
            renderAttributesAndSkills(cardBody, details['屬性'], details['技能'], details['天賦'], details);

            card.append(cardHeader, cardBody);

            // 為每個獨立的同伴卡片綁定點擊事件
            cardHeader.on('click', () => {
                card.toggleClass('active');
                cardBody.slideToggle(200);
            });

            $body.append(card);
        }
    });

    container.append($section);
}

async function p() {
  try {
    const messageId = typeof getCurrentMessageId === 'function' ? getCurrentMessageId() : getChatMessages('last')[0].message_id;
    const message = getChatMessages(messageId)[0];
    const data = message?.data ?? {};
    const statData = data.stat_data ?? {};
    const displayData = data.display_data ?? {};

    if (Object.keys(statData).length === 0 && Object.keys(displayData).length === 0) return;

    const $root = $('#survival-ui').empty();

    r($root, statData);
    createStatusEffects($root, statData);

    const { $section: statusSection, $body: statusBody } = d('角色狀態', false);
    renderUnifiedStatus(statusBody, statData);
    $root.append(statusSection);

    const { $section: skillSection, $body: skillBody } = d('屬性 & 技能', false);
    renderAttributesAndSkills(skillBody, statData['屬性'], statData['技能'], statData['天賦/特性']);
    $root.append(skillSection);

    const get = (key) => (statData?.[key] ?? displayData?.[key]);
    renderCompanions($root, get('同伴'));
